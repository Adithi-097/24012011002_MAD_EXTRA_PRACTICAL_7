<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
    android:id="@+id/txtTitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="38dp"
    android:text="MP3 Player"
    android:textStyle="bold"
    android:textSize="20sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />



    <ImageView
        android:id="@+id/imgAlbum"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/song"
        android:scaleType="centerCrop"
        android:contentDescription="Album Image"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="18dp" />

    <!-- MATERIAL CARD VIEW -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playerCard"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        app:cardBackgroundColor="#EEEAF5"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="#77727D"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/imgAlbum"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <TextView
                android:id="@+id/txtSongName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dosti Music Video"
                android:textColor="#55505B"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="20dp"
                android:layout_marginTop="25dp" />



            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/shuffle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="20dp"
                app:backgroundTint="#55515A"
                app:borderWidth="0dp"
                app:elevation="5dp"
                app:fabSize="mini"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="@drawable/shuffle_24"
                app:tint="#FFFFFF" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/previous_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fabSize="mini"
                app:backgroundTint="#55515A"
                app:borderWidth="0dp"
                app:tint="#FFFFFF"
                app:srcCompat="@drawable/skip_previous_24"
                app:elevation="5dp"
                app:layout_constraintStart_toEndOf="@id/shuffle_button"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="20dp" />




            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/play_button"
                android:layout_width="70dp"
                android:layout_height="60dp"
                app:fabSize="mini"
                app:backgroundTint="#8B3E20"
                app:borderWidth="0dp"
                app:tint="#FFFFFF"
                app:srcCompat="@drawable/baseline_play_arrow_24"
                app:elevation="6dp"
                app:layout_constraintStart_toEndOf="@id/previous_button"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="20dp" />




            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/next_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fabSize="mini"
                app:backgroundTint="#55515A"
                app:borderWidth="0dp"
                app:tint="#FFFFFF"
                app:srcCompat="@drawable/baseline_skip_next_24"
                app:elevation="5dp"
                app:layout_constraintStart_toEndOf="@id/play_button"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="7dp"
                android:layout_marginBottom="20dp" />




            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/stop_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fabSize="mini"
                app:backgroundTint="#55515A"
                app:borderWidth="0dp"
                app:tint="#FFFFFF"
                app:srcCompat="@drawable/baseline_stop_24"
                app:elevation="5dp"
                android:contentDescription="Stop"
                app:layout_constraintStart_toEndOf="@id/next_button"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="20dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>